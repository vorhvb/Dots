# HTop

htop_version = 3.4.1
config_reader_min_version = 3

# General
delay = 10

color_scheme = 0
header_margin = 1
screen_tabs = 0

enable_mouse = 1
hide_function_bar = 1

# Header
header_layout = two_50_50

column_meters_0 = Clock Date Blank Battery
column_meter_modes_0 = 4 2 2 1

column_meters_1 = CPU Memory DiskIO
column_meter_modes_1 = 1 1 3

# Main view
fields = 0 48 17 46 47 53 1
update_process_names = 0

screen:Main = PID USER PRIORITY PERCENT_CPU PERCENT_MEM ELAPSED Command
.tree_view = 1

.sort_key = PERCENT_MEM
.tree_view_always_by_pid = 1
.tree_sort_key = PID

.sort_direction = -1
.tree_sort_direction = 1

.all_branches_collapsed = 0

# Syntax
show_thread_names = 0
show_program_path = 0
highlight_base_name = 1

# Filtre
hide_userland_threads = 0
hide_kernel_threads = 1
hide_running_in_container = 1

# Highlightings
highlight_changes = 0
highlight_changes_delay_secs = 5

highlight_megabytes = 1
highlight_threads = 1
highlight_deleted_exe = 1

shadow_other_users = 1
shadow_distribution_path_prefix = 1

# CPU
detailed_cpu_time = 0
show_cpu_usage = 1
show_cpu_frequency = 0

account_guest_in_cpu_meter = 0

cpu_count_from_one = 1

# Memory
show_cached_memory = 0

# Tree & sortage
tree_view = 1

sort_key = 47
sort_direction = -1

tree_view_always_by_pid = 1
tree_sort_key = 0
tree_sort_direction = 1

all_branches_collapsed = 0

# Magic+
show_merged_command = 0

find_comm_in_cmdline = 1
strip_exe_from_cmdline = 1
