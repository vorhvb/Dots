// Zed
//
// Installed:
// 	ASM
// 	GLSL
//
// 	HTML
//
// 	Java Kotlin
//
// 	QML XML Make
// 	Git Docker

{
	// General
	"theme":
	{
		"light": "Tomorrow",
		"dark": "Tomorrow Night"
	},
	"icon_theme": "Material Icon Theme",
	"restore_on_startup": "last_workspace",

	// Fonts
	"buffer_font_family": "JetBrains Mono",

	"ui_font_size": 15,
	"ui_font_weight": 500,

	"buffer_font_size": 15,
	"buffer_font_weight": 500,
	"buffer_line_height": "standard",

	// UI settings
	"title_bar":
	{
		"show_sign_in": false,
		"show_user_picture": false,
		"show_user_menu": false,

		"show_onboarding_banner": false
	},

	"toolbar": {"agent_review": false},

	"use_system_window_tabs": true,
	"tab_bar": {"show_nav_history_buttons": false},
	"tabs":
	{
		"file_icons": true,
		"activate_on_close": "neighbour"
	},

	"centered_layout":
	{
		"left_padding": 0.25,
		"right_padding": 0.25
	},

	// Panels
	"active_pane_modifiers": {"inactive_opacity": 0.5},

	"project_panel":
	{
		"default_width": 300,
		"dock": "left",

		"hide_root": true,
		"hide_hidden": true,

		"sort_mode": "mixed",

		"auto_fold_dirs": false,
		"sticky_scroll": false,
		"indent_guides": {"show": "never"},

		"indent_size": 15,

		"git_status": false,
		"hide_gitignore": false
	},
	"git_panel":
	{
		"dock": "left",
		"default_width": 300,

		"tree_view": true,
		"file_icons": true,

		"collapse_untracked_diff": true
	},

	"collaboration_panel":
	{
		"default_width": 300,
		"button": false
	},
	"tasks": {"enabled": false},

	// Editor look
	"gutter": {"min_line_number_digits": 5},
	"minimap":
	{
		"thumb": "hover",
		"max_width_columns": 100
	},
	"scrollbar":
	{
		"git_diff": false,
		"diagnostics": "error"
	},

	// Editor & LSP
	"lsp_highlight_debounce": 100,

	"document_symbols": "on",
	"document_folding_ranges": "on",
	"semantic_tokens": "combined",

	"diagnostics_max_severity": "warning",
	"diagnostics":
	{
		"lsp_pull_diagnostics": {"debounce_ms": 100},
		"inline":
		{
			"update_debounce_ms": 100,
			"padding": 10
		}
	},

	"current_line_highlight": "all",
	"colorize_brackets": true,
	"indent_guides": {"coloring": "indent_aware"},

	"inlay_hints":
	{
		"enabled": false,

		"edit_debounce_ms": 0,
		"scroll_debounce_ms": 0
	},
	"sticky_scroll": {"enabled": true},

	"show_wrap_guides": false,
	"redact_private_values": true,

	"vim": {"highlight_on_yank_duration": 100},

	// Crucial
	"format_on_save": "off",
	"preferred_line_length": 100,

	"soft_wrap": "editor_width",
	"hard_tabs": true,
	"tab_size": 4,

	// Tools
	"search": {"button": false},
	"debugger":
	{
		"button": false,
		"timeout": 60
	},
	"outline_panel":
	{
		"dock": "left",

		"auto_fold_dirs": false,
		"indent_guides": {"show": "never"},
		"indent_size": 15,

		"expand_outlines_with_depth": 100,
		"git_status": false
	},

	"git":
	{
		"inline_blame": {"enabled": false},
		"branch_picker": {"show_author_name": false}
	},
	"terminal":
	{
		"default_width": 500,
		"default_height": 300,

		"font_family": "Noto Sans Mono",
		"cursor_shape": "underline",
		"font_weight": 500,

		"max_scroll_history_lines": 100000,
		"minimum_contrast": 50
	},

	// AI
	"disable_ai": true,
	"agent":
	{
		"default_width": 500,
		"default_height": 300,

		"favorite_models": [],
		"model_parameters": [],
		"play_sound_when_agent_done": "always",

		"message_editor_min_lines": 1
	},
	"edit_predictions": {"mode": "subtle"},

	// Magic numbers
	"minimum_contrast_for_highlights": 50,
	"excerpt_context_lines": 3,

	"modeline_lines": 0,
	"vertical_scroll_margin": 5,
	"fast_scroll_sensitivity": 3,

	"drag_and_drop_selection": {"delay": 500},
	"drop_target_size": 0.5,

	"hover_popover_delay": 500
}
